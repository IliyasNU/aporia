# Optional overrides for docker-compose.yml. Copy to .env (git-ignored) and edit.
# The defaults are for local development only: change the password anywhere else.

APP_ENV=development
LOG_LEVEL=INFO

# Comma-separated browser origins allowed to change data (CSRF protection).
# The default covers the web app and Swagger UI on the ports below.
# TRUSTED_ORIGINS=https://aporia.example
SESSION_TTL_DAYS=14

POSTGRES_DB=aporia
POSTGRES_USER=aporia
POSTGRES_PASSWORD=aporia

# Host ports (bound to 127.0.0.1 only).
POSTGRES_PORT=5432
WEB_PORT=8080

# Email. Defaults send everything to Mailpit (http://localhost:8025).
# For production: a long random SECRET_KEY, your public URL and real SMTP credentials.
# SECRET_KEY=change-me-to-a-long-random-value
# PUBLIC_BASE_URL=https://aporia.example
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_STARTTLS=true
# MAIL_FROM=Aporia <no-reply@aporia.example>
MAILPIT_PORT=8025
MAILPIT_SMTP_PORT=1025
